{
	admin off
	persist_config off
	auto_https off
}

:{$PORT} {
	# Railway's healthcheck (no login).
	handle /healthz {
		respond "ok" 200
	}

	@protected not path /healthz
	basic_auth @protected {
		{$DASHBOARD_USERNAME} {$DASHBOARD_PASSWORD_HASH}
	}

	# Typesense API on the private network, same origin as the dashboard
	# ("SAME" host mode, path /api). The browser's login header is dropped.
	handle_path /api/* {
		reverse_proxy {$TYPESENSE_UPSTREAM} {
			header_up -Authorization
		}
	}

	handle {
		header /config.json Cache-Control "no-store"
		root * /srv
		file_server
	}
}
